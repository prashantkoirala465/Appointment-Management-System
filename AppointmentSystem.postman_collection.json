  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const json = pm.response.json();",
                  "    pm.collectionVariables.set('token', json.token);",
                  "    console.log('Token saved:', json.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"Admin@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/authapi/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "authapi", "login"]
            },
            "description": "Authenticates a user and returns a JWT token. The test script automatically saves the token to the `token` collection variable so all other requests are authenticated."
          }
        },
        {
          "name": "Get Current User (Me)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/authapi/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "authapi", "me"]
            },
            "description": "Returns details about the currently authenticated user."
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/authapi/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "authapi", "logout"]
            },
            "description": "Clears the session cookie. Note: JWT tokens expire naturally and cannot be server-side revoked."
          }
        }
      ]
    },
    {
      "name": "Staffs",
      "description": "CRUD operations for staff members. GET endpoints require any authenticated user; POST, PUT, DELETE require Admin role.",
      "item": [
        {
          "name": "Get All Staffs",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const json = pm.response.json();",
                  "    if (json.length > 0) {",
                  "        pm.collectionVariables.set('staffId', json[0].id);",
                  "        console.log('staffId set to:', json[0].id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/staffsapi",
              "host": ["{{baseUrl}}"],
              "path": ["api", "staffsapi"]
            },
            "description": "Returns all staff members with their appointment counts. Also auto-saves the first staff ID into the `staffId` variable."
          }
        },
        {
          "name": "Get Staff by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/staffsapi/{{staffId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "staffsapi", "{{staffId}}"]
            },
            "description": "Returns a single staff member by their GUID. Uses the `staffId` variable saved from Get All Staffs."
          }
        },
        {
          "name": "Create Staff",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const json = pm.response.json();",
                  "    pm.collectionVariables.set('staffId', json.id);",
                  "    console.log('New staffId saved:', json.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Dr. Jane Smith\",\n  \"email\": \"jane.smith@clinic.com\",\n  \"phoneNumber\": \"555-0101\",\n  \"specialty\": \"General Practice\",\n  \"isActive\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/staffsapi",
              "host": ["{{baseUrl}}"],
              "path": ["api", "staffsapi"]
            },
            "description": "Creates a new staff member. Admin only. Responds with 201 Created and the new staff record. Also auto-saves the new ID to `staffId`."
          }
        },
        {
          "name": "Update Staff",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Dr. Jane Smith (Updated)\",\n  \"email\": \"jane.updated@clinic.com\",\n  \"phoneNumber\": \"555-0199\",\n  \"specialty\": \"Cardiology\",\n  \"isActive\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/staffsapi/{{staffId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "staffsapi", "{{staffId}}"]
            },
            "description": "Updates an existing staff member by ID. Admin only. Responds with 200 OK and the updated record."
          }
        },
        {
          "name": "Delete Staff",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/staffsapi/{{staffId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "staffsapi", "{{staffId}}"]
            },
            "description": "Deletes a staff member. If the staff has linked appointments, performs a soft-delete (deactivates). Otherwise permanently removes. Admin only."
          }
        }
      ]
    },
