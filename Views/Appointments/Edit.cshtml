@* ===== EDIT APPOINTMENT VIEW =====
   Almost identical to Create, but the form is pre-filled with existing appointment data.
   The hidden Id field is critical — it tells the controller WHICH appointment to update. *@

@model AppointmentSystem.Web.Models.Appointment
@{
    ViewData["Title"] = "Edit Appointment";
}

<div style="margin-bottom: var(--space-xl);">
    <h1 class="page-title">Edit Appointment</h1>
    <p class="page-subtitle">Update the appointment details below.</p>
</div>

<div class="card-custom" style="max-width:640px;">
    <div class="card-body-custom">
        @* POSTs to /Appointments/Edit — the controller matches the Id from the hidden field *@
        <form asp-action="Edit" class="form-custom">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            @* IMPORTANT: hidden Id field — without this the controller won't know which record to update *@
            <input type="hidden" asp-for="Id" />

            <div class="form-group">
                <label asp-for="StaffId">Staff</label>
                <select asp-for="StaffId" class="form-input" asp-items="ViewBag.StaffId"></select>
                <span asp-validation-for="StaffId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="ClientName">Client Name</label>
                <input asp-for="ClientName" class="form-input" />
                <span asp-validation-for="ClientName" class="text-danger"></span>
            </div>

            <div style="display:grid; grid-template-columns:1fr 1fr; gap:var(--space-md);">
                <div class="form-group">
                    <label asp-for="ClientEmail">Email</label>
                    <input asp-for="ClientEmail" class="form-input" />
                    <span asp-validation-for="ClientEmail" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="ClientPhone">Phone</label>
                    <input asp-for="ClientPhone" class="form-input" />
                    <span asp-validation-for="ClientPhone" class="text-danger"></span>
                </div>
            </div>

            <div style="display:grid; grid-template-columns:1fr 1fr; gap:var(--space-md);">
                <div class="form-group">
                    <label asp-for="StartTime">Start Time</label>
                    <input asp-for="StartTime" class="form-input" />
                    <span asp-validation-for="StartTime" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="DurationMinutes">Duration (min)</label>
                    <input asp-for="DurationMinutes" class="form-input" />
                    <span asp-validation-for="DurationMinutes" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="Status">Status</label>
                <select asp-for="Status" class="form-input">
                    <option value="Scheduled">Scheduled</option>
                    <option value="Completed">Completed</option>
                    <option value="Cancelled">Cancelled</option>
                    <option value="No-Show">No-Show</option>
                </select>
                <span asp-validation-for="Status" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Notes">Notes</label>
                <textarea asp-for="Notes" class="form-input" rows="3"></textarea>
                <span asp-validation-for="Notes" class="text-danger"></span>
            </div>

            <div class="btn-group-custom" style="margin-top:var(--space-lg);">
                <button type="submit" class="btn-primary-custom">Save Changes</button>
                <a class="btn-secondary-custom" asp-action="Index">Cancel</a>
            </div>
        </form>
    </div>
</div>

@* Load client-side validation scripts so the form checks required fields before submitting *@
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
